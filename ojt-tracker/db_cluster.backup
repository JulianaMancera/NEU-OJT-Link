--
-- Name: application Admins can select all applications; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Admins can select all applications" ON public.application FOR SELECT USING (((auth.role() = 'authenticated'::text) AND ((auth.jwt() ->> 'role'::text) = 'admin'::text)));


--
-- Name: application Admins can update application status; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Admins can update application status" ON public.application FOR UPDATE USING (((auth.role() = 'authenticated'::text) AND ((auth.jwt() ->> 'role'::text) = 'admin'::text))) WITH CHECK (true);


--
-- Name: weekly_journal Admins can update journals; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Admins can update journals" ON public.weekly_journal FOR UPDATE USING ((EXISTS ( SELECT 1
   FROM public."user" u
  WHERE ((u.user_id = auth.uid()) AND (u.role = 'admin'::public.user_role)))));


--
-- Name: weekly_report Admins can update weekly status; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Admins can update weekly status" ON public.weekly_report FOR UPDATE USING (((auth.role() = 'authenticated'::text) AND ((auth.jwt() ->> 'role'::text) = 'admin'::text))) WITH CHECK (true);


--
-- Name: user Allow all authenticated users to read user table; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Allow all authenticated users to read user table" ON public."user" FOR SELECT TO authenticated USING (true);


--
-- Name: availability Allow authenticated users to insert availability; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Allow authenticated users to insert availability" ON public.availability FOR INSERT TO authenticated WITH CHECK (true);


--
-- Name: job Allow authenticated users to update jobs; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Allow authenticated users to update jobs" ON public.job FOR UPDATE TO authenticated USING (true) WITH CHECK (true);


--
-- Name: holidays Allow public read access to holidays; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Allow public read access to holidays" ON public.holidays FOR SELECT USING (true);


--
-- Name: availability Allow users to view their own availability; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Allow users to view their own availability" ON public.availability FOR SELECT TO authenticated USING ((application_id IN ( SELECT application.application_id
   FROM public.application
  WHERE (application.user_id = auth.uid()))));


--
-- Name: weekly_journal Can insert own journals; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Can insert own journals" ON public.weekly_journal FOR INSERT WITH CHECK ((submitted_by = (((auth.jwt())::json -> 'user_metadata'::text) ->> 'full_name'::text)));


--
-- Name: weekly_journal Can update own journals; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Can update own journals" ON public.weekly_journal FOR UPDATE USING ((user_id = auth.uid())) WITH CHECK ((user_id = auth.uid()));


--
-- Name: weekly_journal Can view journals; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Can view journals" ON public.weekly_journal FOR SELECT USING (((user_id = auth.uid()) OR (EXISTS ( SELECT 1
   FROM public."user" u
  WHERE ((u.user_id = auth.uid()) AND (u.role = 'admin'::public.user_role))))));


--
-- Name: weekly_journal Can view own journals; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Can view own journals" ON public.weekly_journal FOR SELECT USING ((submitted_by = (((auth.jwt())::json -> 'user_metadata'::text) ->> 'full_name'::text)));


